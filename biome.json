{
  "assist": {
    "actions": {
      "preset": "recommended",
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "lexicographic"
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "scenarios/**/*.ts",
      "docs/**/*.ts",
      "benchmarks/**/*.ts",
      "scripts/**/*.mjs",
      "biome.json",
      "tsconfig*.json",
      "benchmarks/configs/**/*.json",
      "benchmarks/schemas/**/*.json",
      "package.json",
      "vitest.config.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noShadowRestrictedNames": "off"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json"
}
