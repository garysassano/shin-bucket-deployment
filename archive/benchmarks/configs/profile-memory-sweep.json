{
  "$schema": "../schemas/asset-benchmark-config.schema.json",
  "repetitions": 1,
  "region": "eu-central-1",
  "concurrency": 2,
  "assetProfiles": ["tiny-many", "large-few"],
  "implementations": ["shin"],
  "lambdaConfigs": [
    { "memoryMb": 1024, "parallel": 32 },
    { "memoryMb": 2048, "parallel": 64 },
    { "memoryMb": 4096, "parallel": 128 },
    { "memoryMb": 1024, "parallel": 128 },
    { "memoryMb": 2048, "parallel": 128 }
  ],
  "phases": [
    { "name": "cold-create", "assetState": "baseline" },
    { "name": "unchanged-update", "assetState": "baseline", "deleteCurrentObjectsOnDelete": false },
    { "name": "changed-update", "assetState": "changed" },
    { "name": "pruned-update", "assetState": "pruned" }
  ]
}
