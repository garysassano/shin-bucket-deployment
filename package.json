{
  "name": "shin-bucket-deployment",
  "version": "0.13.0",
  "description": "Rust-backed AWS CDK construct for performance-sensitive S3 asset deployment",
  "license": "MIT",
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "s3",
    "bucket-deployment",
    "rust",
    "lambda",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garysassano/shin-bucket-deployment.git"
  },
  "homepage": "https://github.com/garysassano/shin-bucket-deployment#readme",
  "bugs": {
    "url": "https://github.com/garysassano/shin-bucket-deployment/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/cataloged-source.d.ts",
    "lib/defaults.d.ts",
    "lib/enums.d.ts",
    "lib/errors.d.ts",
    "lib/index.d.ts",
    "lib/shin-bucket-deployment.d.ts",
    "assets/bootstrap-arm64/bootstrap.zip",
    "assets/bootstrap-arm64/build-provenance.json",
    "assets/bootstrap-x86_64/bootstrap.zip",
    "assets/bootstrap-x86_64/build-provenance.json"
  ],
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:package": "tsc -p tsconfig.package.json",
    "build:bootstrap": "node scripts/build-bootstrap.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "rust:fmt": "cargo fmt --manifest-path rust/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path rust/Cargo.toml --all --check",
    "rust:check": "cargo check --manifest-path rust/Cargo.toml --all-targets --all-features",
    "rust:bench": "cargo bench --manifest-path rust/Cargo.toml --features bench-internals",
    "rust:bench:allocations": "cargo bench --manifest-path rust/Cargo.toml --bench plan_key_allocations --features bench-key-allocations",
    "rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --all-features",
    "rust:audit": "cargo audit --file rust/Cargo.lock",
    "rust:deny": "cargo deny --manifest-path rust/Cargo.toml check",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:ci": "vitest run --maxWorkers=2 && node --test scripts/*.test.mjs",
    "workflow:lint": "actionlint",
    "toml:check": "taplo fmt --check mise.toml rust/Cargo.toml rust/deny.toml",
    "npm:audit": "pnpm audit --audit-level high",
    "verify:benchmark-config": "pnpm build && node scripts/generate-benchmark-config-schema.mjs --check",
    "verify:bootstrap-assets": "node scripts/verify-bootstrap-assets.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:ledger": "node dist/benchmarks/src/verify-ledger.js",
    "verify:wire-contract": "node scripts/generate-wire-schema.mjs --check",
    "verify:synth": "pnpm verify synth",
    "verify:typescript-contract": "node scripts/verify-typescript-refactor.mjs",
    "scenario": "pnpm build && node dist/scenarios/runner.js",
    "verify": "pnpm build && node dist/scenarios/runner.js verify",
    "benchmark": "pnpm build && node dist/scenarios/runner.js benchmark",
    "benchmark:config-schema": "pnpm build && node scripts/generate-benchmark-config-schema.mjs",
    "benchmark:collect": "pnpm build && node dist/benchmarks/src/collect-results.js",
    "benchmark:catalog-synth": "pnpm build && node scripts/benchmark-catalog-synthesis.mjs",
    "benchmark:comparison-report": "pnpm build && node dist/benchmarks/src/render/comparison-report.js",
    "benchmark:merge-shards": "pnpm build && node dist/benchmarks/src/merge-shards.js",
    "benchmark:publish-results": "pnpm build && node dist/benchmarks/src/publish-results.js",
    "benchmark:telemetry-table": "pnpm build && node dist/benchmarks/src/render/telemetry-table.js",
    "benchmark:run-assets": "pnpm build && node dist/benchmarks/src/run-assets-comparison.js",
    "benchmark:oidc:synth": "pnpm build && cdk synth --app 'node dist/benchmarks/infra/gha-oidc-app.js' shin-bucket-deployment-gha-oidc",
    "benchmark:oidc:diff": "pnpm build && cdk diff --app 'node dist/benchmarks/infra/gha-oidc-app.js' shin-bucket-deployment-gha-oidc",
    "benchmark:oidc:deploy": "pnpm build && cdk deploy --app 'node dist/benchmarks/infra/gha-oidc-app.js' shin-bucket-deployment-gha-oidc",
    "benchmark:oidc:destroy": "pnpm build && cdk destroy --app 'node dist/benchmarks/infra/gha-oidc-app.js' shin-bucket-deployment-gha-oidc",
    "benchmark:synth": "pnpm build && node scripts/verify-benchmark-plan.mjs && SHIN_BENCH_EXECUTION_ENVIRONMENT_TOKEN=no-aws-synth SHIN_BENCH_INVOCATION_TOKEN=no-aws-synth-invocation node dist/scenarios/runner.js benchmark synth assets --asset-profiles tiny-many --implementations shin,aws --transfer-max-concurrency 32 --lambda-memory-mb 1024 && node scripts/verify-benchmark-synth.mjs",
    "check": "pnpm verify:bootstrap-assets && pnpm build && pnpm build:package && pnpm typecheck && pnpm lint && pnpm check:md && pnpm test && pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test && pnpm npm:audit && pnpm rust:audit && pnpm rust:deny && pnpm workflow:lint && pnpm toml:check && pnpm verify:package && pnpm verify:wire-contract && pnpm verify:benchmark-config && pnpm verify:synth && pnpm benchmark:synth && pnpm verify:ledger",
    "check:md": "prettier --check \"**/*.md\"",
    "format:md": "prettier --write \"**/*.md\"",
    "prepack": "pnpm build:package"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.257.0",
    "cargo-lambda-cdk": ">=0.0.36 <1.0.0",
    "constructs": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "cargo-lambda-cdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "3.1118.0",
    "@aws-sdk/client-s3": "3.1118.0",
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "aws-cdk": "2.1139.0",
    "aws-cdk-lib": "2.266.0",
    "cargo-lambda-cdk": "0.0.36",
    "constructs": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "zod": "^4.4.3"
  }
}
