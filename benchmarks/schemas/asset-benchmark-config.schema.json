{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "startRepetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxWallClockMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "preserveOnFailure": { "type": "boolean" },
    "detailedFailureDiagnostics": { "type": "boolean" },
    "runToken": { "type": "string", "minLength": 1 },
    "snapshotDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "region": { "type": "string", "minLength": 1 },
    "outputFile": { "type": "string", "minLength": 1 },
    "scratchRoot": { "type": "string", "minLength": 1 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 4 },
    "destinationPrefix": { "type": "string", "minLength": 1 },
    "assetProfiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tiny-many",
          "mixed",
          "large-few",
          "marker-heavy",
          "multi-source-prune",
          "uncataloged",
          "copy-archives"
        ]
      }
    },
    "lambdaConfigs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "memoryMb": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "parallel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sourceWindowBytes": {
            "anyOf": [
              { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          }
        },
        "required": ["memoryMb", "parallel"],
        "additionalProperties": false
      }
    },
    "implementations": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "enum": ["shin", "aws"] }
    },
    "phases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetState": {
            "type": "string",
            "enum": ["baseline", "changed", "pruned"]
          },
          "cloudfrontWait": { "type": "boolean" },
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "deleteStaleObjects": { "type": "boolean" },
          "deleteCurrentObjectsOnDelete": { "type": "boolean" }
        },
        "required": ["assetState", "name"],
        "additionalProperties": false
      }
    },
    "decisionRunId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "comparisonVariant": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
  },
  "additionalProperties": false,
  "title": "ShinBucketDeployment Asset Benchmark Config"
}
